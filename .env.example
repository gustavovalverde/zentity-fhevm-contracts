# Runtime (optional)
# NODE_ENV=development

# Local/test accounts (optional)
# Uses Hardhat default if unset.
MNEMONIC="test test test test test test test test test test test junk"

# Deployment keys (testnet only)
FHEVM_PRIVATE_KEY=0x_your_fhevm_deployer_private_key_here
BASE_SEPOLIA_PRIVATE_KEY=0x_your_base_deployer_private_key_here
BASE_SEPOLIA_REGISTRAR_ADDRESS=0x_your_base_registrar_address_here

# Networks (public RPC)
# Generic Sepolia RPC (no key required)
FHEVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Provider implementation (kept for alignment with app repo; not used here)
# relayer = Zama relayer SDK (current FHEVM provider on Sepolia)
FHEVM_PROVIDER_ID=relayer

# Verification (optional)
ETHERSCAN_API_KEY=your_api_key

# Deployed Addresses (filled after deployment)
FHEVM_IDENTITY_REGISTRY=
FHEVM_COMPLIANCE_RULES=
FHEVM_COMPLIANT_ERC20=
BASE_SEPOLIA_IDENTITY_REGISTRY_MIRROR=

{
  "name": "@zentity/contracts",
  "version": "0.9.0",
  "description": "Zentity smart contracts, ABIs, deployments, and typed helpers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "abi/",
    "contracts/interfaces/",
    "deployments/baseSepolia/addresses.json",
    "deployments/hardhat/addresses.json",
    "deployments/sepolia/addresses.json",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./abi/index.d.ts",
      "default": "./abi/index.js"
    },
    "./abi/IdentityRegistry": "./abi/IdentityRegistry.json",
    "./abi/IdentityRegistryMirror": "./abi/IdentityRegistryMirror.json",
    "./abi/ComplianceRules": "./abi/ComplianceRules.json",
    "./abi/CompliantERC20": "./abi/CompliantERC20.json",
    "./deployments/baseSepolia": "./deployments/baseSepolia/addresses.json",
    "./deployments/hardhat": "./deployments/hardhat/addresses.json",
    "./deployments/sepolia": "./deployments/sepolia/addresses.json"
  },
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test",
    "test:local": "hardhat test --network localhost",
    "test:sepolia": "hardhat test mocha --network sepolia test/integration/FullFlow.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "fix": "bun run lint:fix && bun run lint:sol:fix && bun run format",
    "fix:verify": "bun run fix && bun run verify",
    "verify": "bun run lint && bun run lint:sol && bun run compile && bun run typecheck",
    "verify:full": "bun run verify && bun run test",
    "deploy:local": "hardhat ignition deploy ignition/modules/Confidential.ts --network localhost && hardhat ignition deploy ignition/modules/IdentityRegistryMirror.ts --network localhost && bun run consolidate localhost && bun run validate:local",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/Confidential.ts --network sepolia && bun run consolidate sepolia",
    "deploy:base-sepolia": "hardhat ignition deploy ignition/modules/IdentityRegistryMirror.ts --network baseSepolia --parameters ignition/parameters/baseSepolia.json && bun run consolidate baseSepolia && bun run validate:base-sepolia",
    "validate:local": "DEPLOYMENT_VALIDATION_WRITES=true hardhat run scripts/validate-deployments.ts --network localhost",
    "validate:sepolia": "hardhat run scripts/validate-deployments.ts --network sepolia",
    "validate:base-sepolia": "hardhat run scripts/validate-deployments.ts --network baseSepolia",
    "export-abi": "bun scripts/export-abi.ts",
    "print:deployments": "bun scripts/print-deployments.ts",
    "consolidate": "bun scripts/consolidate-deployments.ts",
    "build": "bun run compile && bun run export-abi && bun run consolidate && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish",
    "clean": "hardhat clean && rm -rf dist typechain-types abi/*.json src/abi",
    "prepare": "husky"
  },
  "dependencies": {
    "@fhevm/solidity": "0.13.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@fhevm/hardhat-plugin-v3": "0.13.1",
    "@fhevm/sdk": "0.13.8",
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^12.0.3",
    "solhint": "^6.0.2",
    "typescript": "^7.0.2",
    "viem": "^2.58.0"
  },
  "peerDependencies": {
    "viem": "^2.43.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavovalverde/zentity-fhevm-contracts.git"
  },
  "keywords": [
    "confidential",
    "fhevm",
    "fhe",
    "zama",
    "identity",
    "compliance",
    "privacy",
    "ethereum",
    "solidity"
  ],
  "author": "Gustavo Valverde",
  "license": "MIT"
}

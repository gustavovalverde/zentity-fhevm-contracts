{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "src/**/*",
    "typechain-types/**/*",
    "scripts/**/*",
    "test/**/*",
    "ignition/**/*",
    "hardhat.config.ts"
  ],
  "exclude": ["node_modules", "artifacts", "cache"]
}
